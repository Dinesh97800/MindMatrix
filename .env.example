# Pre-launch: keep search engines from indexing (default when unset).
# Set to false when the site goes live.
NEXT_PUBLIC_PRELAUNCH=true

# Canonical base URL for metadata, sitemap, and JSON-LD (set before launch).
NEXT_PUBLIC_SITE_URL=https://mmisindia.com

# --- MySQL (required for contact forms + admin panel) ---
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=mind_matrix
MYSQL_USER=mind_matrix_user
MYSQL_PASSWORD=your_secure_password

# Set to true only during development if you changed model columns and need auto-migration
# Tables are created automatically when missing — this flag is NOT required for first setup
# CMS schema should use `npm run db:migrate` instead of sync alter in production.
DB_SYNC_ALTER=false

# --- CMS media storage (Hostinger VPS) ---
# Persistent directory OUTSIDE the git/deploy folder, e.g. /var/www/mindmatrix/uploads/cms
CMS_UPLOAD_DIR=/var/www/mindmatrix/uploads/cms
# Max image upload size in bytes (default 10 MB)
CMS_MAX_UPLOAD_BYTES=10485760
# Public media URL base (default /api/cms/media)
CMS_MEDIA_PUBLIC_BASE=/api/cms/media

# CMS capability flags — current client phase keeps structural editing disabled
CMS_DYNAMIC_PAGE_CREATION=false
CMS_PAGE_DELETION=false
CMS_DYNAMIC_SECTIONS=false
CMS_SECTION_DELETION=false
CMS_SECTION_DUPLICATION=false
CMS_SECTION_REORDERING=false
CMS_SECTION_VISIBILITY=false
CMS_TEMPLATE_CHANGES=false
CMS_CATEGORY_MANAGEMENT=false
CMS_CONTENT_EDITING=true
CMS_MEDIA_EDITING=true
CMS_SEO_EDITING=true
CMS_SETTINGS_EDITING=true
CMS_BLOG_MANAGEMENT=true

# --- Auth (required for admin panel) ---
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=generate_a_long_random_secret_here

# First super admin (used by npm run db:seed)
ADMIN_SEED_NAME=Super Admin
ADMIN_SEED_EMAIL=admin@mindmatrix.com
ADMIN_SEED_PASSWORD=ChangeMe123!

# --- Email alerts on new submissions ---
ADMIN_ALERT_EMAIL=team@mindmatrix.com
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your_smtp_user
SMTP_PASSWORD=your_smtp_password
SMTP_FROM="Mind Matrix <noreply@mindmatrix.com>"
